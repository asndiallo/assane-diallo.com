---
import type { Dictionary } from "../i18n/index.ts";

interface Props {
  t: Dictionary;
}
const { theme } = Astro.props.t;
// Click order: system → light → dark → system. Keep in sync with the script below.
const options = [
  {
    value: "system",
    label: theme.system,
    icon: '<rect x="3" y="4" width="18" height="12" rx="2"/><path d="M8 20h8M12 16v4"/>',
  },
  {
    value: "light",
    label: theme.light,
    icon: '<circle cx="12" cy="12" r="4"/><path d="M12 2v2M12 20v2M4.9 4.9l1.4 1.4M17.7 17.7l1.4 1.4M2 12h2M20 12h2M4.9 19.1l1.4-1.4M17.7 6.3l1.4-1.4"/>',
  },
  { value: "dark", label: theme.dark, icon: '<path d="M20 14.5A8 8 0 0 1 9.5 4a8 8 0 1 0 10.5 10.5z"/>' },
];
---

<!--
  One button showing the current theme; each click moves to the next. Which icon and label show
  is pure CSS on html[data-theme] (global.css), set by the head script before first paint, so the
  button is right before this script runs. Shown only when html[data-js] is set: without
  JavaScript the site simply follows the system theme.
-->
<button
  type="button"
  data-theme-toggle
  class="size-10 shrink-0 place-items-center rounded-full border border-line text-muted hover:bg-wash hover:text-ink"
>
  {
    options.map((o) => (
      <span data-theme-option={o.value} title={`${theme.label}: ${o.label}`}>
        <svg
          aria-hidden="true"
          width="18"
          height="18"
          viewBox="0 0 24 24"
          fill="none"
          stroke="currentColor"
          stroke-width="2"
          stroke-linecap="round"
          stroke-linejoin="round"
          set:html={o.icon}
        />
        <span class="sr-only">
          {theme.label}: {o.label}
        </span>
      </span>
    ))
  }
</button>

<script>
  // Bundled by Astro (allowed by the CSP as 'self'); runs after the page is parsed.
  const root = document.documentElement;
  const order = ["system", "light", "dark"] as const;

  for (const button of document.querySelectorAll<HTMLButtonElement>("[data-theme-toggle]")) {
    button.addEventListener("click", () => {
      const current = root.dataset.theme ?? "system";
      const next = order[(order.indexOf(current as (typeof order)[number]) + 1) % order.length] ?? "system";
      if (next === "system") delete root.dataset.theme;
      else root.dataset.theme = next;
      try {
        if (next === "system") localStorage.removeItem("theme");
        else localStorage.setItem("theme", next);
      } catch {
        // Storage can be blocked (private mode); the choice then lasts for this page only.
      }
    });
  }
</script>
