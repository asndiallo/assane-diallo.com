---
import type { Dictionary } from "../../i18n/index.ts";
import { bookingHref } from "../../lib/contact.ts";
import CtaWhatsApp from "../CtaWhatsApp.astro";
import Link from "../Link.astro";
import ListingCard from "../ListingCard.astro";
import MapPin from "../MapPin.astro";
import Todo from "../Todo.astro";

interface Props {
  t: Dictionary;
}
const { t } = Astro.props;
const { hero, listing } = t.home;
const booking = bookingHref();
---

<section aria-labelledby="hero-h" class="overflow-hidden">
  <div
    class="container-page grid items-center gap-12 py-12 sm:py-20 lg:grid-cols-[1.15fr_1fr] lg:gap-16"
  >
    <div>
      <h1 id="hero-h" class="max-w-[18ch]">{hero.h1}</h1>
      <p class="measure mt-6 text-lg text-muted sm:text-xl">{hero.subhead}</p>
      <div class="mt-8 flex flex-wrap items-center gap-3">
        <CtaWhatsApp t={t} />
        {
          booking ? (
            <Link class="btn btn-secondary" href={booking}>
              {t.cta.booking}
            </Link>
          ) : (
            <span class="btn btn-secondary flex-col gap-1">
              {t.cta.booking}
              <Todo label="booking link in src/config.ts" />
            </span>
          )
        }
      </div>
      <p class="mt-4 text-muted">{hero.languages}</p>
    </div>

    <figure class="relative mx-auto w-full max-w-md">
      <!-- A street-grid "map" behind the listing: the point is being found nearby. -->
      <div
        aria-hidden="true"
        class="map-grid relative rounded-4xl bg-wash px-5 pt-16 pb-8 sm:px-8"
      >
        <MapPin class="absolute top-4 right-8 h-14 w-14" />

        <div class="rounded-full border border-line bg-paper px-4 py-2.5 text-[0.95rem] text-muted shadow-sm">
          <svg aria-hidden="true" class="mr-2 inline h-4 w-4 align-middle" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round"><circle cx="10.5" cy="10.5" r="6.5" /><path d="m20 20-4.8-4.8" /></svg><span class="typer inline-grid" data-typer>
            {listing.searches.map((search) => <span class="typer-sizer">{search.query}</span>)}
            <span class="typer-line" data-typed>{listing.searches[0]?.query}</span>
          </span>
        </div>

        <ListingCard t={t} rotate class="mt-4" />
      </div>
      <figcaption class="mt-3 text-sm text-muted">{listing.caption}</figcaption>
    </figure>
  </div>
</section>

<script>
  // One slow pass through the verticals, ending back on the first: each search is typed like a
  // visitor would, then the listing's category answers it. The illustration is aria-hidden, so
  // screen readers never hear the changes; reduced motion (and no JS) keeps the first pair.
  const typer = document.querySelector<HTMLElement>("[data-typer]");
  const typed = typer?.querySelector<HTMLElement>("[data-typed]");
  const queries = [...(typer?.querySelectorAll(".typer-sizer") ?? [])].map((el) => el.textContent ?? "");
  const categories = document.querySelectorAll<HTMLElement>("[data-rotate]");
  const count = queries.length;

  const HOLD = 1800; // reading time for a search and its result
  const ERASE = 30; // per character
  const TYPE = 65; // per character, ± a little so it feels typed, not printed

  const wait = (ms: number) => new Promise((resolve) => setTimeout(resolve, ms));
  // A hidden tab waits: the visitor should see the pass, not miss it.
  const shown = async () => {
    while (document.hidden) {
      await new Promise((resolve) => document.addEventListener("visibilitychange", resolve, { once: true }));
    }
  };

  const showCategory = (index: number, previous: number) => {
    for (const group of categories) {
      for (const [i, item] of [...group.children].entries()) {
        item.classList.toggle("is-active", i === index);
        item.classList.toggle("is-leaving", i === previous);
      }
    }
  };

  const run = async (line: HTMLElement, box: HTMLElement) => {
    box.classList.add("is-typing");
    for (let index = 1; index <= count; index++) {
      await wait(HOLD);
      await shown();
      const next = index % count;
      while (line.textContent) {
        line.textContent = line.textContent.slice(0, -1);
        await wait(ERASE);
      }
      for (const char of queries[next] ?? "") {
        line.textContent += char;
        await wait(TYPE + (Math.random() - 0.5) * 40);
      }
      showCategory(next, index - 1);
    }
    box.classList.remove("is-typing");
  };

  if (typer && typed && count > 1 && !matchMedia("(prefers-reduced-motion: reduce)").matches) {
    run(typed, typer);
  }
</script>
