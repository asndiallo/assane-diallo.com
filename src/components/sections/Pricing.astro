---
import { pricing } from "../../config.ts";
import type { Dictionary } from "../../i18n/index.ts";
import CtaWhatsApp from "../CtaWhatsApp.astro";
import Section from "../Section.astro";

interface Props {
  t: Dictionary;
}
const { t } = Astro.props;
const { pricing: copy, services } = t.home;
const check = "m5 12.5 4.5 4.5L19 7.5";
---

<Section id="pricing" heading={copy.h2} band="wash">
  <p class="measure mt-4 text-lg">{copy.intro}</p>
  <p class="measure mt-4 border-l-4 border-sun pl-4">{copy.payback}</p>

  <div class="mt-10 grid items-start gap-6 md:grid-cols-2">
    {
      pricing.tiers.map((tier, i) => {
        // A higher tier lists only what it adds to the one before it.
        const prev = pricing.tiers[i - 1];
        const prevName = prev ? copy.tiers[prev.id].name : "";
        const name = copy.tiers[tier.id].name;
        const lists = [
          {
            title: copy.monthlyPlan,
            items: tier.monthly
              .filter((id) => !prev?.monthly.some((p) => p === id))
              .map((id) => copy.monthlyItems[id]),
          },
          {
            title: copy.includes,
            items: tier.includes
              .filter((id) => !prev?.includes.some((p) => p === id))
              .map((id) => services.items[id].title.replace(/\.$/, "")),
          },
        ];
        return (
          <article
            class:list={[
              "flex flex-col rounded-2xl border-2 bg-paper p-6 sm:p-8",
              // The recommended package comes first on phones, where only one card shows at a time.
              tier.recommended ? "order-first border-brand md:order-none" : "border-line",
            ]}
          >
            <div class="flex flex-wrap items-baseline justify-between gap-x-3 gap-y-1">
              <h3 class="text-2xl">{name}</h3>
              {tier.recommended && <p class="text-sm font-semibold text-brand">{copy.recommended}</p>}
            </div>
            <p class="mt-1 text-muted">{copy.tiers[tier.id].tagline}</p>

            <!-- The price is the one large thing on the card. Each amount stays on one line with its unit. -->
            <p class="mt-6">
              <span class="block text-sm text-muted">{copy.foundingLabel}, {copy.startingAtLower}</span>
              <span class="whitespace-nowrap">
                <span class="font-serif text-6xl leading-tight font-bold">{t.money(tier.founding.monthly)}</span>{" "}
                <span class="text-lg">{copy.perMonth}</span>
              </span>
              <span class="block">
                + <span class="whitespace-nowrap">{t.money(tier.founding.setup)}</span> {copy.setupOnce}
              </span>
            </p>
            <p class="mt-2 text-sm text-muted">
              {copy.standardLabel}{t.colon} {t.money(tier.standard.monthly)} {copy.perMonth} +{" "}
              {t.money(tier.standard.setup)} {copy.setup}.
            </p>

            <ul class="mt-6 divide-y divide-line border-y border-line">
              {tier.outcomes.map((id) => (
                <li class="py-3">
                  <span class="block font-semibold">{copy.outcomes[id].title}</span>
                  <span class="block text-sm text-muted">{copy.outcomes[id].body}</span>
                </li>
              ))}
            </ul>

            <CtaWhatsApp
              t={t}
              variant={tier.recommended ? "default" : "secondary"}
              label={copy.choose(name)}
              message={copy.chooseMessage(name)}
              class="mt-8 w-full"
            />

            <details class="group mt-4">
              <summary class="flex cursor-pointer list-none items-center justify-between gap-4 py-2 font-semibold text-brand [&::-webkit-details-marker]:hidden">
                {copy.details}
                <span aria-hidden="true" class="text-2xl leading-none text-brand transition-transform group-open:rotate-45">
                  +
                </span>
              </summary>
              {prev && <p class="mt-3 text-sm text-muted">{copy.everythingIn(prevName)}</p>}
              {lists.map((list) => (
                <>
                  <h4 class="mt-4 text-sm font-semibold">{list.title}</h4>
                  <ul class="mt-2 space-y-2 text-sm">
                    {list.items.map((label) => (
                      <li class="flex gap-2">
                        <svg aria-hidden="true" class="mt-0.5 h-4 w-4 shrink-0 text-brand" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
                          <path d={check} />
                        </svg>
                        {label}
                      </li>
                    ))}
                  </ul>
                </>
              ))}
            </details>
          </article>
        );
      })
    }
  </div>
  <p class="mt-4 text-sm text-muted">{copy.quote}</p>

  <ul class="mt-10 grid gap-x-8 gap-y-6 sm:grid-cols-2 lg:grid-cols-4">
    {
      copy.promises.map((promise) => (
        <li class="border-l-2 border-brand pl-4">
          <h3 class="text-base">{promise.title}</h3>
          <p class="mt-1 text-sm text-muted">{promise.body}</p>
        </li>
      ))
    }
  </ul>
</Section>
