---
import { type CollectionEntry, render } from "astro:content";
import { SITE_URL } from "../../config.ts";
import { getDictionary, staticRoutes } from "../../i18n/index.ts";
import Page from "../../layouts/Page.astro";
import { entryAlternates, entryLocale, entryPath, sibling } from "../../lib/content.ts";
import { personSchema } from "../../lib/schema.ts";
import CtaWhatsApp from "../CtaWhatsApp.astro";
import ListingCard from "../ListingCard.astro";

interface Props {
  entry: CollectionEntry<"guides">;
}
const { entry } = Astro.props;
const { title, description, h1, lead, reviewed, draft, summary, listing } = entry.data;
const locale = entryLocale(entry);
const t = getDictionary(locale);
const { Content, headings } = await render(entry);
const alternates = await entryAlternates("guides", entry);

// A guide belongs to a business type: same key, same locale. The build fails without one.
const vertical = await sibling("verticals", entry);
if (!vertical) throw new Error(`Guide ${entry.id} has no matching business type page`);
const verticalUrl = entryPath("verticals", vertical);
const url = new URL(entryPath("guides", entry), SITE_URL).href;
const reviewedText = reviewed.toLocaleDateString(locale, { dateStyle: "long", timeZone: "UTC" });

// Jump links: the guide's own sections, not the Sources heading.
const toc = headings.filter((h) => h.depth === 2 && h.slug !== "footnote-label");

const article = {
  "@context": "https://schema.org",
  "@type": "Article",
  headline: h1,
  description,
  url,
  inLanguage: locale,
  dateModified: reviewed.toISOString().slice(0, 10),
  author: { "@context": "https://schema.org", ...personSchema },
};
const breadcrumbs = {
  "@context": "https://schema.org",
  "@type": "BreadcrumbList",
  itemListElement: [
    { "@type": "ListItem", position: 1, name: t.caseStudy.home, item: new URL(staticRoutes.home[locale], SITE_URL).href },
    { "@type": "ListItem", position: 2, name: t.guide.types, item: new URL(staticRoutes.verticals[locale], SITE_URL).href },
    { "@type": "ListItem", position: 3, name: vertical.data.name, item: new URL(verticalUrl, SITE_URL).href },
    { "@type": "ListItem", position: 4, name: h1, item: url },
  ],
};
const boxH2 = "text-2xl";
---

<Page
  title={title}
  description={description}
  h1={h1}
  lead={lead}
  locale={locale}
  alternates={alternates}
  ogType="article"
  jsonLd={[article, breadcrumbs]}
>
  <p class="mt-4 text-sm text-muted" data-draft={draft || undefined}>
    {t.guide.reviewed(reviewedText)} <a href={verticalUrl}>{t.guide.back(vertical.data.name)}</a>
  </p>

  <div class="mt-10 lg:grid lg:grid-cols-[minmax(0,1fr)_15rem] lg:gap-12">
    <div class="min-w-0">
      <section class="measure rounded-2xl border-2 border-ink p-6 shadow-[6px_6px_0_var(--color-ink)]" aria-labelledby="summary">
        <h2 id="summary" class={boxH2}>{t.guide.summaryH2}</h2>
        <ol class="mt-4 list-decimal space-y-2 pl-6">{summary.map((item) => <li>{item}</li>)}</ol>
      </section>

      <section class="mt-12 grid max-w-3xl items-start gap-8 md:grid-cols-[minmax(0,22rem)_1fr]" aria-labelledby="anatomy">
        <h2 id="anatomy" class:list={[boxH2, "md:col-span-2"]}>{t.guide.anatomy.h2}</h2>
        <figure class="max-w-[22rem]">
          <div aria-hidden="true">
            <ListingCard t={t} example={listing} markers />
          </div>
          <figcaption class="mt-4 text-sm text-muted">{t.guide.anatomy.caption}</figcaption>
        </figure>
        <ol class="list-decimal space-y-3 pl-6">{t.guide.anatomy.parts.map((part) => <li>{part}</li>)}</ol>
      </section>

      <details class="mt-12 rounded-2xl border border-line p-4 lg:hidden">
        <summary class="cursor-pointer font-semibold">{t.guide.toc} ({toc.length})</summary>
        <ol class="mt-3 space-y-2 pl-1">{toc.map((h) => <li><a href={`#${h.slug}`}>{h.text}</a></li>)}</ol>
      </details>

      <article class="prose mt-12">
        <Content />
      </article>

      <section class="mt-16 rounded-2xl bg-wash p-6 sm:p-10">
        <h2 class="text-3xl">{t.guide.nextH2}</h2>
        <p class="measure mt-4">{t.guide.next}</p>
        <div class="mt-6 flex flex-wrap gap-4">
          <CtaWhatsApp t={t} />
          <a class="btn btn-secondary" href={staticRoutes.checklist[locale]}>{t.guide.checklist}</a>
        </div>
      </section>
    </div>

    <nav class="hidden lg:block" aria-label={t.guide.toc}>
      <div class="sticky top-6">
        <p class="text-sm font-bold tracking-wide uppercase text-muted">{t.guide.toc}</p>
        <ol class="mt-3 space-y-2 border-l border-line pl-4 text-sm">
          {toc.map((h) => <li><a href={`#${h.slug}`} class="no-underline hover:underline">{h.text}</a></li>)}
        </ol>
      </div>
    </nav>
  </div>
</Page>
